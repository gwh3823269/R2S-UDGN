# standard
from thop import profile
import argparse
import torch
import torch.nn.functional as F
import torch.nn as nn
import numpy as np
import copy
import random
import time
import math
from torch.utils.tensorboard import SummaryWriter
from tqdm import tqdm
import pandas as pd
from scipy.io import loadmat, savemat
# 
import eeg_utils
import models_adv
#import models_pac
#random seed
def setup_seed(seed):
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed) 
    np.random.seed(seed)
    torch.backends.cudnn.deterministic = True

setup_seed(0)

writer = SummaryWriter()
device = torch.device("cuda:0" if torch.cuda.is_available() else "cpu")
print("Using device:", device)
filename = 'log0.txt'
file = open(filename, 'w', encoding='utf-8')


class MSMDAER():
    def __init__(self, model, source_loaders, target_loader, batch_size=64, iteration=10000, lr=0.01, momentum=0.9, log_interval=10):
        self.model = model
        self.model.to(device)
        self.source_loaders = source_loaders
        self.target_loader = target_loader
        self.batch_size = batch_size
        self.iteration = iteration
        self.lr = lr
        self.momentum = momentum
        self.log_interval = log_interval

        # ✅ Optimizer initialized once
        self.optimizer = torch.optim.Adam(self.model.parameters(), lr=self.lr)

    def __getModel__(self):
        return self.model

    def train(self):
        best_model_wts = copy.deepcopy(self.model.state_dict())
        source_iters = []
        for i in range(len(self.source_loaders)):
            source_iters.append(iter(self.source_loaders[i]))
        target_iter = iter(self.target_loader)
        correct = 0
        
        progress = tqdm(range(self.iteration+1))
        
        for i in progress:
        #for i in range(1, self.iteration+1):
            self.model.train()
           # LEARNING_RATE = self.lr / math.pow((1 + 10 * (i - 1) / (self.iteration)), 0.75)
            LEARNING_RATE = self.lr
            if (i - 1) % 100 == 0:
                print("Learning rate: ", LEARNING_RATE)
            #optimizer = torch.optim.SGD(self.model.parameters(), lr=LEARNING_RATE, momentum=self.momentum)
            optimizer = torch.optim.Adam(self.model.parameters(), lr=LEARNING_RATE)
            
            for j in range(len(source_iters)):
                try:
                    source_data, source_label = next(source_iters[j])
                    #print(source_data.shape)
                except Exception as err:
                    source_iters[j] = iter(self.source_loaders[j])
                    source_data, source_label = next(source_iters[j])
                try:
                    target_data, _ = next(target_iter)
                except Exception as err:
                    target_iter = iter(self.target_loader)
                    target_data, _ = next(target_iter)
                source_data, source_label = source_data.to(device), source_label.to(device)
                target_data = target_data.to(device)

                optimizer.zero_grad()
                cls_loss, mmd_loss, disc_loss,pacbayes_loss, adv_loss,mean_laplacian,channel_importance = self.model(source_data, number_of_source=len(source_iters), data_tgt=target_data, label_src=source_label, mark=j)
                gamma = 2 / (1 + math.exp(-10 * (i) / (self.iteration))) - 1
                beta = gamma/10
                delta=0.001      
                loss = cls_loss +gamma * mmd_loss + 0.01*disc_loss+0.01*adv_loss
                #loss = cls_loss + gamma * mmd_loss + delta*adv_loss
               # loss = cls_loss + gamma * mmd_loss + beta * l1_loss+ delta*disc_loss_s
               # loss = cls_loss + beta * l1_loss+ delta*disc_loss_s
                loss.backward()
                optimizer.step()

                if i % log_interval == 0:
                    print(' Train source' + str(j) + ', iter: {} [({:.0f}%)]\loss: {:.6f}\cls_loss: {:.6f}\mmd_loss: {:.6f}\disc_loss: {:.6f}\pacbayes_loss {:.6f}\adv_loss: {:.6f}'.format(
                        i, 100.*i/self.iteration, loss.item(), cls_loss.item(), mmd_loss.item(), disc_loss.item(), pacbayes_loss.item(),adv_loss.item()
                        )
                    )
            if i % (log_interval * 1) == 0:
                
                t_correct = self.test(i,loss)
                if t_correct > correct:
                    correct = t_correct
                  #  torch.save(best_model_wts, 'model_param_seed3_subj_62.pkl', _use_new_zipfile_serialization=False)
                print('to target max correct: ', correct.item(), "\n")
                if isinstance(mean_laplacian, torch.Tensor):
                    mean_laplacian = mean_laplacian.detach().cpu().numpy()  # 先 detach() 断开梯度追踪
                  # 转为 pandas DataFrame
                    df = pd.DataFrame(mean_laplacian)
                    
                  # 保存为 Excel 文件
                    df.to_excel('mean_laplacian3-14.xlsx', index=False, header=False)
                    np.savetxt('mean_laplacian3-14.txt', mean_laplacian, fmt='%.6f')
            if isinstance(channel_importance, torch.Tensor):
                channel_imp_np = channel_importance.detach().cpu().numpy()  # shape: [N] 或 [B, N]
        
        # 如果是 [B, N]，取 batch 平均得到 [N]
                if channel_imp_np.ndim == 2:
                    channel_imp_np = channel_imp_np.mean(axis=0)  # [N]
                
                # 转为 DataFrame（单列）
                df_importance = pd.DataFrame(channel_imp_np, columns=['importance'])
                # 保存为 Excel（注意：文件名必须带 .xlsx 后缀！）
                df_importance.to_excel('channel_importance3-0.xlsx', index=False, header=True)
                # 也可以保存为 txt
                np.savetxt('channel_importance3-14.txt', channel_imp_np, fmt='%.6f')

        return 100. * correct / len(self.target_loader.dataset)
    
    def test(self, iters, loss):
        conf_matrix = torch.zeros(4, 4)
        def update_confusion(preds, labels, matrix):
            preds = torch.argmax(preds, dim=1)
            for p, t in zip(preds, labels):
                matrix[p.long(), t.long()] += 1
            return matrix

        self.model.eval()
        test_loss = 0
        correct = 0
        corrects = [0 for _ in range(len(self.source_loaders))]
        labels_list = []

        with torch.no_grad():
            for data, target in self.target_loader:
                data = data.to(device)
                target = target.to(device).squeeze().long()  # Ensure 1D long tensor

                preds = self.model(data, len(self.source_loaders))  # list of logits

                probs = [F.softmax(p, dim=1) for p in preds]
                avg_prob = sum(probs) / len(probs)

                test_loss += F.nll_loss(F.log_softmax(avg_prob, dim=1), target).item()
                pred_label = avg_prob.argmax(dim=1)
                correct += pred_label.eq(target).sum().item()

                for j in range(len(probs)):
                    pred_j = probs[j].argmax(dim=1)
                    corrects[j] += pred_j.eq(target).sum().item()

                conf_matrix = update_confusion(avg_prob, target, conf_matrix)
                labels_list.append(target.cpu().numpy())

        test_loss /= len(self.target_loader)
        acc = 100. * correct / len(self.target_loader.dataset)

        print(conf_matrix)
        print('\nTest set: Average loss: {:.4f}, Accuracy: {}/{} ({:.2f}%)\n'.format(
            test_loss, correct, len(self.target_loader.dataset), acc
        ))

        file.write('\niteration:{}\ttrain_loss:{:.4f}\ttest_loss:{:.4f}\tAcc:{:.2f}\nconf_matrix:\n{}\n'.format(
            iters, loss.item(), test_loss, acc, conf_matrix.numpy()
        ))

        for n in range(len(corrects)):
            print('Source{} acc num: {}'.format(n, corrects[n]))

        # Feature saving removed (not implemented in forward)
        print('Note: Feature saving disabled (not returned by model).')
        return torch.tensor(correct)


def cross_subject(data, label, session_id, category_number, batch_size, iteration, lr, momentum, log_interval):
    one_session_data = copy.deepcopy(data[session_id])
    one_session_label = copy.deepcopy(label[session_id])
    target_data, target_label = one_session_data.pop(12), one_session_label.pop(12)
    source_data, source_label = one_session_data, one_session_label

    source_loaders = []
    for j in range(len(source_data)):
        source_loaders.append(torch.utils.data.DataLoader(
            dataset=eeg_utils.CustomDataset(source_data[j], source_label[j]),
            batch_size=batch_size,
            shuffle=True,
            drop_last=True
        ))
    target_loader = torch.utils.data.DataLoader(
        dataset=eeg_utils.CustomDataset(target_data, target_label),
        batch_size=batch_size,
        shuffle=True,
        drop_last=True
    )

    model = MSMDAER(
        model=models_adv.MSMDAERNet(number_of_source=len(source_loaders), number_of_category=category_number),
        source_loaders=source_loaders,
        target_loader=target_loader,
        batch_size=batch_size,
        iteration=iteration,
        lr=lr,
        momentum=momentum,
        log_interval=log_interval
    )

    dummy_input = torch.randn(batch_size, *source_data[0].shape[1:]).to(device)
    macs, params = profile(model.__getModel__(), inputs=(dummy_input, len(source_loaders)))
    print(f"\nCross-subject model params: {params}")
    print(f"Cross-subject FLOPs: {macs}")

    acc = model.train()
    return acc

def cross_session(data, label, subject_id, category_number, batch_size, iteration, lr, momentum, log_interval):
    target_data = copy.deepcopy(data[0][subject_id])
    target_label = copy.deepcopy(label[0][subject_id])
    source_data = [copy.deepcopy(data[1][subject_id]), copy.deepcopy(data[2][subject_id])]
    source_label = [copy.deepcopy(label[1][subject_id]), copy.deepcopy(label[2][subject_id])]

    source_loaders = []
    for j in range(len(source_data)):
        source_loaders.append(torch.utils.data.DataLoader(
            dataset=eeg_utils.CustomDataset(source_data[j], source_label[j]),
            batch_size=batch_size,
            shuffle=True,
            drop_last=True
        ))

    target_loader = torch.utils.data.DataLoader(
        dataset=eeg_utils.CustomDataset(target_data, target_label),
        batch_size=batch_size,
        shuffle=True,
        drop_last=True
    )

    model = MSMDAER(
        model=models_adv.MSMDAERNet(pretrained=False, number_of_source=len(source_loaders), number_of_category=category_number),
        source_loaders=source_loaders,
        target_loader=target_loader,
        batch_size=batch_size,
        iteration=iteration,
        lr=lr,
        momentum=momentum,
        log_interval=log_interval
    )

    print("\nGCN Model Architecture:")
    print(model.__getModel__())

    dummy_input = torch.randn(batch_size, *source_data[0].shape[1:]).to(device)
    macs, params = profile(model.__getModel__(), inputs=(dummy_input, len(source_loaders)))
    print(f"\nCross-session model params: {params}")
    print(f"Cross-session FLOPs: {macs}")

    acc = model.train()
    return acc


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description='MS-MDAER parameters')
    parser.add_argument('--dataset', type=str, default='seed3', help='dataset: "seed3", "seed4" or "DEAP"')
    parser.add_argument('--norm_type', type=str, default='none', help='normalization: "ele", "sample", "global", "z_score" or "none"')
    parser.add_argument('--batch_size', type=int, default=64, help='batch size')
    parser.add_argument('--epoch', type=int, default=200, help='training epoch')
    parser.add_argument('--lr', type=float, default=0.005, help='learning rate')
    args = parser.parse_args()

    dataset_name = args.dataset
    bn = args.norm_type

    print('Model: MS-MDAER. Dataset:', dataset_name)
    data, label = eeg_utils.load_data(dataset_name)

    print('Normalization:', bn)
    data_tmp = copy.deepcopy(data)
    label_tmp = copy.deepcopy(label)

    if bn == 'ele':
        for i in range(len(data_tmp)):
            for j in range(len(data_tmp[0])):
                data_tmp[i][j] = eeg_utils.norminy(data_tmp[i][j])
    elif bn == 'sample':
        for i in range(len(data_tmp)):
            for j in range(len(data_tmp[0])):
                data_tmp[i][j] = eeg_utils.norminx(data_tmp[i][j])
    elif bn == 'global':
        for i in range(len(data_tmp)):
            for j in range(len(data_tmp[0])):
                data_tmp[i][j] = eeg_utils.normalization(data_tmp[i][j])
    elif bn == 'z_score':
        for i in range(len(data_tmp)):
            for j in range(len(data_tmp[0])):
                data_tmp[i][j] = eeg_utils.z_score_standardization(data_tmp[i][j])
    # 'none' keeps data_tmp as is

    trial_total, category_number, _ = eeg_utils.get_number_of_label_n_trial(dataset_name)

    batch_size = args.batch_size
    epoch = args.epoch
    lr = args.lr
    print('BS: {}, epoch: {}'.format(batch_size, epoch))
    momentum = 0.9
    log_interval = 10
    iteration = 0
    if dataset_name == 'seed3':
        iteration = math.ceil(epoch * 3394 / batch_size)
    elif dataset_name == 'seed4':
        iteration = math.ceil(epoch * 820 / batch_size)
    else:
        iteration = 5000
    print('Total iterations:', iteration)

    csub = []
    csesn = []
    file.write('cross-subject, for 3 sessions, 1-14 as sources, 15 as target\n')
    for i in range(2):
        acc = cross_subject(data_tmp, label_tmp, 2, category_number, batch_size, iteration, lr, momentum, log_interval)
        csub.append(acc)
        print(f"Session {i} cross-subject acc: {acc:.2f}%")

    # file.write('\ncross-session, for 15 subjects, 1-2 as sources, 3 as target\n')
    # for i in range(15):
    #     acc = cross_session(data_tmp, label_tmp, i, category_number, batch_size, iteration, lr, momentum, log_interval)
    #     csesn.append(acc)
    #     print(f"Subject {i} cross-session acc: {acc:.2f}%")

    file.write('Cross-session mean')
    file.write('Cross-session mean')
    print("\n=== Final Results ===")
    print("Cross-session:", csesn)
    print("Cross-subject:", csub)
    print("Cross-session mean: {:.2f}%, std: {:.2f}%".format(np.mean(csesn), np.std(csesn)))
    print("Cross-subject mean: {:.2f}%, std: {:.2f}%".format(np.mean(csub), np.std(csub)))
    file.close()
