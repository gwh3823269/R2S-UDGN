 class TwoStageUncertaintyGuidedGraphAugmentation(nn.Module):
     def __init__(self, in_channels, hidden_dim=64, use_stat_norm=False, fusion_mode='mask'):
         super(TwoStageUncertaintyGuidedGraphAugmentation, self).__init__()
         self.use_stat_norm = use_stat_norm
         self.fusion_mode = fusion_mode
        
         self.uncertainty_refiner = nn.Sequential(
             nn.Linear(in_channels + 2, hidden_dim),
             nn.ReLU(),
             nn.Linear(hidden_dim, 1),
             nn.Sigmoid()
         )
        
         self.edge_weight_predictor = nn.Sequential(
             nn.Linear(in_channels * 2, hidden_dim),
             nn.ReLU(),
             nn.Linear(hidden_dim, 1),
             nn.Sigmoid()
         )
        
         if fusion_mode == 'blend':
             self.alpha = nn.Parameter(torch.tensor(0.5))

     def compute_statistical_uncertainty(self, x):
         mean = torch.mean(x, dim=-1, keepdim=True)
         var = torch.var(x, dim=-1, unbiased=False, keepdim=True)
         stat_features = torch.cat([mean, var], dim=-1)
        
         if self.use_stat_norm:
             mean_stat = stat_features.mean(dim=1, keepdim=True)
             std_stat = stat_features.std(dim=1, keepdim=True) + 1e-8
             stat_features = (stat_features - mean_stat) / std_stat
        
         return stat_features, mean, var

     def forward(self, x, adj_prior):
         B, N, C = x.shape
         stat_features, mean, var = self.compute_statistical_uncertainty(x)
         x_with_stat = torch.cat([x, stat_features], dim=-1)
         refined_uncertainty = self.uncertainty_refiner(x_with_stat)
         uncertainty = refined_uncertainty.squeeze(-1)

         x_i = x.unsqueeze(2).expand(B, N, N, C)
         x_j = x.unsqueeze(1).expand(B, N, N, C)
         edge_input = torch.cat([x_i, x_j], dim=-1)
         edge_weights = self.edge_weight_predictor(edge_input.view(-1, 2*C))
         edge_weights = edge_weights.view(B, N, N)

         if self.fusion_mode == 'mask':
             adj_aug = adj_prior * edge_weights
         elif self.fusion_mode == 'blend':
             alpha = torch.sigmoid(self.alpha)
             adj_aug = alpha * edge_weights + (1 - alpha) * adj_prior
         else:
             raise ValueError(f"Unsupported fusion_mode: {self.fusion_mode}")
        
         u_i = refined_uncertainty.expand(B, N, N)
         u_j = refined_uncertainty.permute(0, 2, 1).expand(B, N, N)
         adj_aug = adj_aug * (1 - u_i * u_j + 1e-8)
         adj_aug = adj_aug * (1 - torch.eye(N, device=x.device).unsqueeze(0))

         return adj_aug, uncertainty, (mean, var)

class TemporalConvNet(nn.Module):
    def __init__(self, in_channels=310, out_channels=128, kernel_size=7, dropout=0.25):
        super().__init__()
        self.net = nn.Sequential(
            nn.Conv1d(in_channels, 64, kernel_size=kernel_size, padding=kernel_size//2),
            nn.BatchNorm1d(64),
            nn.ReLU(),
            nn.Dropout(dropout),
            nn.Conv1d(64, out_channels, kernel_size=kernel_size, padding=kernel_size//2),
            nn.BatchNorm1d(out_channels),
            nn.ReLU(),
            nn.Dropout(dropout),
            
            # 全局平均池化 → 固定长度输出
            nn.AdaptiveAvgPool1d(1)  # 输出 [B, 128, 1]
        )
    
    def forward(self, x):  # x: [B, T, 310] → 转置为 [B, 310, T]
        x = x.transpose(1, 2)  # [B, 310, T]
        out = self.net(x).squeeze(-1)  # [B, 128]
        return out

