class PGCN(nn.Module):
    """
    PGCN with Uncertainty-Guided Graph Augmentation
    """
    def __init__(self, args, local_adj, coor):
        super(PGCN, self).__init__()

        self.args = args
        self.nclass = args.n_class
        self.dropout = args.dropout
        self.l_relu = args.lr
        self.adj = local_adj  # [N, N] static prior adjacency
        self.coordinate = coor

 
        self.graph_augmentor = TwoStageUncertaintyGuidedGraphAugmentation(
            in_channels=args.in_feature,
            hidden_dim=64,
            use_stat_norm=False,
            fusion_mode='mask'
        )

        # GCN layers
        self.local_gcn_1 = DynamicGraphConv(args.in_feature, 10, dropout=self.dropout)
        self.local_gcn_2 = DynamicGraphConv(10, 15, dropout=self.dropout)

        self.static_mlp = nn.Sequential(
            nn.Linear(62*5, 256),
            nn.Linear(256, 128),
            nn.Linear(128, 256),
            nn.ReLU(),
            nn.Dropout(0.25)
        )
        # Temporal branch
        self.rnn1 = nn.LSTM(
            input_size=256,
            hidden_size=256,
            num_layers=2,
            batch_first=True,
            dropout=0.25,
            bidirectional=False,
        )
        self.module = nn.Sequential(
            nn.Linear(256, 128),  # 128*2 (bidirectional) → 128
            nn.BatchNorm1d(128),
            nn.LeakyReLU(negative_slope=0.01, inplace=True)
        )

        # Fusion & Classification
        self.mlp0 = nn.Linear(62 * 30, 128)  # from concatenated local features
        self.w = nn.Parameter(torch.full((2,), 0.5))
        self.module2 = nn.Sequential(
            nn.Linear(128, 64),
            nn.BatchNorm1d(64),
            nn.LeakyReLU(negative_slope=0.01, inplace=True)
        )
        

        self.lrelu = nn.ReLU(self.l_relu)
        self.w = nn.Parameter(torch.zeros(3)) 

    def forward(self, x):
        # x: [B, N=62, C=5]
        B, N, C = x.shape


        adj_prior = self.adj.unsqueeze(0).expand(B, N, N).to(x.device)
        adj_aug, uncertainty, _ = self.graph_augmentor(x, adj_prior)
        laplacian = normalize_adj(adj_aug)  # [B, N, N]
        #laplacian = normalize_adj(adj_prior)  # [B, N, N]
        
        mean_laplacian = laplacian.mean(dim=0)
        
        node_importance = (1.0 - uncertainty).unsqueeze(-1)  # [B, N, 1]
        
        x_weighted = x * node_importance  # 抑制高不确定性节点
        B,N,C=x_weighted.shape
        channel_importance=x_weighted.reshape(N,-1)
        channel_importance =channel_importance.mean(dim=1)
        # print('++'*100,channel_importance.shape)
        # === Step 3: Temporal branch (LSTM) ===
        # 将 x flatten 成 [B, 310]，再加时间维 [B, 1, 310]
        x_flat = x.view(B, -1).unsqueeze(1)  # [B, 1, 310]
        out = self.static_mlp(x_flat)  # [B, 256]
        #out, _ = self.rnn1(out)           # [B, 1, 256]
        out = out.squeeze(1)                 # [B, 256]
        out = self.module(out)               # [B, 128]

        # === Step 4: Local GCN with weighted features ===
        local_x1 = self.lrelu(self.local_gcn_1(x_weighted, laplacian))
        local_x2 = self.lrelu(self.local_gcn_2(local_x1, laplacian))
        res_local = torch.cat([x_weighted, local_x1, local_x2], dim=2)  # [B, 62, 30]

        x0 = self.mlp0(res_local.view(B, -1))  # [B, 128]

   
        w1 = torch.exp(self.w[0]) / torch.sum(torch.exp(self.w))
        w2 = torch.exp(self.w[1]) / torch.sum(torch.exp(self.w))
      #  fused_feat = w1 * out + w2 * x0  # [B, 128]
      # fused_feat = out#只有TIE22
        fused_feat = x0  # [B, 128]只有图24
        final_feat = self.module2(fused_feat)  # [B, 64]


        return final_feat, uncertainty.mean(dim=1),mean_laplacian,channel_importance  # [B, 64], [B]
